---
// HungVuongConcertSection.astro - Khu vực giới thiệu Hùng Vương Concert (Our Inspiration) & Bản đồ trường THPT Chuyên Hùng Vương
---

<section class="section hvc-story-section" id="stage-hungvuongconcert">
  <div class="stage">
    <div class="wrapper event">
      <div class="bubble-wrapper">
        <div class="heading-div" style="padding-bottom: 20px;">
          <h3>HUNG VUONG CONCERT</h3>
        </div>
        <div class="top-bubble">
          <div class="top-left-bubble">
            <img src="/images/bubble/1.webp" loading="lazy" alt="" class="bubble-img" />
            <img src="/images/bubble/2.webp" loading="lazy" alt="" class="bubble-img" />
          </div>
          <div class="top-right-bubble">
            <img src="/images/bubble/3.webp" loading="lazy" alt="" class="bubble-img" />
          </div>
        </div>
        <div class="bottom-bubble">
          <img src="/images/bubble/4.webp" loading="lazy" alt="" class="bubble-img" />
          <img src="/images/bubble/5.webp" loading="lazy" alt="" class="bubble-img" />
        </div>
      </div>
      <div class="event-section">
        <div class="row">
          <div class="col image-col">
            <img
              src="/images/tuthien.webp"
              alt="Hùng Vương Concert"
              class="event-image"
              loading="lazy"
              style="width: 500px; height: 300px;"
            />
          </div>
          <div class="col text-col">
            <div class="event-text">
              <p>Our Inspiration</p>
              <div class="event-text-info">
                Hùng Vương Concert là tổ chức phi lợi nhuận với mục đích vận động, quyên góp từ thiện,
                được tổ chức hằng năm tại trường THPT chuyên Hùng Vương, tỉnh Bình Dương. Mỗi mùa, chương
                trình bao gồm nhiều hoạt động gây quỹ, đặc biệt là đêm nhạc hoành tráng được tổ chức quy mô,
                chuyên nghiệp với sự góp mặt của nhiều ca sĩ, diễn viên được đông đảo khán giả yêu thích.
                Chương trình vừa là món quà tinh thần hấp dẫn, vừa là chiếc cầu nối cho những tấm lòng thiện nguyện.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- --------------- Location Map ----------------- -->
<section class="section orange hvc-location-section">
  <div class="map">
    <div class="wrapper">
      <div class="heading-div">
        <p>OuR LocAtioN</p>
      </div>
      <div class="map-div">
        <div class="location-left-div">
          <div class="banner-div" style="margin-top: 70px;">
            <img style="border-radius: 20px;" src="/images/chv.webp" loading="lazy" alt="Trường THPT Chuyên Hùng Vương" />
          </div>
        </div>
        <div class="map-wrapper">
          <div class="map-embed w-embed w-iframe">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d15666.485014648724!2d106.657564!3d10.9919341!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3174d1141576a027%3A0x368ecd5b0de7834d!2sHung%20Vuong%20High%20School%20for%20The%20Gifted!5e0!3m2!1sen!2s!4v1733487065472!5m2!1sen!2s"
              width="600"
              height="350"
              style="border:0; border-radius: 20px"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
