---
// TicketSection.astro - Khu vực e-Ticket với không gian hiển thị rộng rãi, nổi bật, giữ nguyên toàn bộ cấu trúc box
---

<div class="sectionn eticket-showcase-section" id="ticket-section">
  <!-- E-Ticket Card Box (giữ nguyên vẹn toàn bộ cấu trúc và nội dung) -->
  <div class="ticket-item last">
    <div class="ticket-item-left">
      <div class="top-div">
        <div class="ticket-title">
          GAMEON - e-TicKet 
          <img src="/images/e-ticket.webp" style="height: 25px; width: auto" alt="E-Ticket Icon" />
        </div>
        <div class="ticket-info">
          Với giao diện đẹp và thao tác đơn giản, vé điện tử không chỉ là "chân ái" cho người chơi hệ
          nhanh - gọn - lẹ mà còn vô cùng tiện lợi cho các khán giả ở xa đó!
        </div>
      </div>
      <div class="bottom-div">
        <div class="prize-text">320.000 đ</div>
        <div class="ticket-button-div">
          <a id="button" href="/eticket-form" target="_blank" class="button w-inline-block">
            <div class="button-text" style="color: white">Mua vé</div>
          </a>
        </div>
      </div>
    </div>
  </div>

  <button class="button check-btn" onclick="window.location.href='/ticketInfo'">
    Check Your E-Ticket
  </button>
</div>

<style is:global>
  /* Khu vực chứa E-Ticket: Tăng diện tích hiển thị rộng rãi, thoáng đãng */
  #ticket-section.eticket-showcase-section {
    min-height: 85vh !important;
    min-height: 85dvh !important;
    padding: clamp(90px, 14vh, 160px) clamp(20px, 4vw, 60px) !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 32px !important;
    position: relative !important;
    background: radial-gradient(circle at 50% 50%, rgba(2, 18, 238, 0.14) 0%, rgba(8, 25, 16, 0.96) 65%, #081910 100%) !important;
    box-sizing: border-box !important;
    width: 100% !important;
  }

  /* Giữ nguyên cấu trúc card, tối ưu không gian hiển thị rộng rãi */
  #ticket-section .ticket-item {
    width: min(92%, 920px) !important;
    max-width: 920px !important;
    padding: clamp(32px, 5vw, 48px) !important;
    background: linear-gradient(#ffffff, #ffffff) padding-box,
                linear-gradient(110deg, #116B09 0%, #0212EE 58%, #D20001 100%) border-box !important;
    border-radius: 22px !important;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.4), 0 0 30px rgba(2, 18, 238, 0.15) !important;
    transition: transform 0.3s ease, box-shadow 0.3s ease !important;
  }

  #ticket-section .ticket-item:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 35px rgba(210, 0, 1, 0.25) !important;
  }

  #ticket-section .check-btn {
    padding: 12px 32px !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    letter-spacing: 0.5px !important;
    border-radius: 30px !important;
    box-shadow: 3px 3px 0px #0212EE, 0 8px 20px rgba(0, 0, 0, 0.3) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    cursor: pointer !important;
  }

  #ticket-section .check-btn:hover {
    transform: translateY(-2px) !important;
    box-shadow: 4px 4px 0px #D20001, 0 10px 25px rgba(0, 0, 0, 0.4) !important;
  }

  @media screen and (max-width: 768px) {
    #ticket-section.eticket-showcase-section {
      min-height: 70vh !important;
      padding: 60px 16px !important;
      gap: 24px !important;
    }
  }
</style>
