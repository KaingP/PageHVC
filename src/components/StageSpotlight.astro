---
// StageSpotlight.astro - Khu vực trình chiếu ảnh Concert với hiệu ứng Retro Pixel Dissolve từ dưới lên trên (DEMO1 Style)
const stages = [
  {
    num: "01",
    title: "THE AWAKENING",
    img: "/images/data/1.webp",
    alt: "Stage 01 - The Awakening"
  },
  {
    num: "02",
    title: "NEON OVERDRIVE",
    img: "/images/data/2.webp",
    alt: "Stage 02 - Neon Overdrive"
  },
  {
    num: "03",
    title: "YOUTH SYMPHONY",
    img: "/images/data/3.webp",
    alt: "Stage 03 - Youth Symphony"
  },
  {
    num: "04",
    title: "ARCADE FEVER",
    img: "/images/data/4.webp",
    alt: "Stage 04 - Arcade Fever"
  },
  {
    num: "05",
    title: "GAMEON FINALE",
    img: "/images/data/5.webp",
    alt: "Stage 05 - Gameon Finale"
  }
];
---

<section class="spotlight" id="stage-spotlight">
  <!-- Retro Game HUD góc màn hình (DEMO1 style, chuẩn bảng màu thương hiệu) -->
  <div class="retro-hud">
    <div class="hud-item"><span class="blink-dot">●</span> 1UP: <span id="hud-score">00000</span></div>
    <div class="hud-item">STAGE: <span id="hud-level">01</span> / 05</div>
    <div class="hud-item pixel-accent">DISSOLVE: <span id="hud-status">STANDBY</span></div>
  </div>

  <!-- Danh sách các ảnh Stage -->
  {stages.map((stage) => (
    <div class="spotlight-image" data-stage={stage.num}>
      <img src={stage.img} alt={stage.alt} loading="lazy" />
      <div class="stage-tag">
        STAGE {stage.num}: {stage.title}
      </div>
    </div>
  ))}

  <!-- Khung chứa lưới hạt Pixel Dissolve nhiều màu sắc -->
  <div class="dissolve-grid"></div>
</section>

<style is:global>
  /* Spotlight Section Container */
  .spotlight {
    position: relative !important;
    width: 100% !important;
    height: 100vh !important;
    height: 100dvh !important;
    overflow: hidden !important;
    background-color: #081910 !important;
  }

  .spotlight-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    will-change: clip-path;
  }

  .spotlight-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.12) saturate(1.15) brightness(0.92);
  }

  /* Thẻ STAGE TAG phong cách 8-bit Arcade chuẩn bảng màu */
  .stage-tag {
    position: absolute;
    bottom: 35px;
    left: 35px;
    background: rgba(8, 25, 16, 0.92);
    color: #FFFFFF;
    font-family: var(--font-gameon, 'Upheaval', monospace);
    font-size: 1.6rem;
    padding: 10px 20px;
    border-left: 5px solid #D20001;
    border-bottom: 3px solid #FFA62B;
    box-shadow: 4px 4px 0px #0212EE;
    z-index: 10;
    letter-spacing: 2px;
    text-shadow: 0 0 10px rgba(210, 0, 1, 0.6);
    user-select: none;
    backdrop-filter: blur(6px);
  }

  /* Retro HUD hiển thị thông số 8-bit */
  .retro-hud {
    position: absolute;
    top: 90px;
    left: 25px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: rgba(8, 25, 16, 0.88);
    padding: 10px 16px;
    border: 2.5px solid #D20001;
    box-shadow: 3px 3px 0px #0212EE;
    font-family: var(--font-gameon, 'Upheaval', monospace);
    font-size: 1.15rem;
    letter-spacing: 1.5px;
    color: #FFFFFF;
    backdrop-filter: blur(6px);
    user-select: none;
  }

  .hud-item {
    color: #FFFFFF;
    text-shadow: 1px 1px #081910;
  }

  .hud-item .blink-dot {
    color: #116B09;
    animation: hudDotBlink 0.8s infinite steps(1);
  }

  .pixel-accent {
    color: #FFA62B;
  }

  @keyframes hudDotBlink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* Khung chứa các ô Dissolve Pixel */
  .dissolve-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 30;
    pointer-events: none;
  }

  .dissolve-cell {
    position: absolute;
    visibility: hidden;
    font-family: var(--font-gameon, 'Upheaval', monospace);
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.4), inset -1px -1px 0 rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(8, 25, 16, 0.4);
    overflow: hidden;
    line-height: 1;
    transition: opacity 0.06s ease;
  }

  @media screen and (max-width: 768px) {
    .stage-tag {
      font-size: 1.1rem;
      bottom: 20px;
      left: 20px;
      padding: 6px 12px;
    }
    .retro-hud {
      top: 75px;
      left: 15px;
      font-size: 0.95rem;
      padding: 6px 10px;
    }
  }
</style>
