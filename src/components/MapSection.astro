---
// MapSection.astro - Sơ đồ sân khấu HVC GAMEON
---

<div class="section" id="mapstagesection">
  <div class="map-stage">
    <div class="wrapper no-padding">
      <div class="wrapper home-map-wrapper">
        <div class="heading-div">
          <p id="map-title">GAMEON - MaP</p>
        </div>
        <div class="map-content-wrapper">
          <div class="map-img-card">
            <img src="/images/map.webp" loading="lazy" alt="Sơ đồ sân khấu Hung Vuong Concert" />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
